<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="box_survey">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.58 0.60 0.62 1</ambient>
      <background>0.70 0.82 0.94 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Global Terrain Plane: Natural Meadow Soil Surface -->
    <model name="global_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.36 0.44 0.32 1</ambient>
            <diffuse>0.40 0.48 0.35 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <!-- ================================================================ -->
    <!-- REAL-WORLD TACTICAL SURVEY PROVING GROUND: 120m x 90m            -->
    <!-- PX4 NED: X in [0, 120]m (North), Y in [-45, 45]m (East)           -->
    <!-- Gazebo ENU: Y in [0, 120]m (North), X in [-45, 45]m (East)        -->
    <!-- ================================================================ -->

    <!-- Compacted Gravel Perimeter Access Road (Surrounds Survey Arena) -->
    <model name="perimeter_access_road">
      <static>true</static>
      <pose>0.0 60.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="road_surface">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>98.0 128.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.44 0.40 0.34 1</ambient>
            <diffuse>0.48 0.44 0.37 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Weathered Tarmac Survey Apron (Authentic Asphalt Proving Ground) -->
    <model name="survey_zone_apron">
      <static>true</static>
      <pose>0.0 60.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="asphalt">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>90.0 120.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.28 0.30 1</ambient>
            <diffuse>0.32 0.32 0.34 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Survey Demarcation Markings (Ground-Painted Boundary Lines) -->
    <model name="painted_survey_perimeter">
      <static>true</static>
      <pose>0.0 60.0 0.003 0 0 0</pose>
      <link name="link">
        <!-- North line -->
        <visual name="line_n">
          <pose>0 60.0 0 0 0 0</pose>
          <geometry><box><size>90.0 0.20 0.001</size></box></geometry>
          <material><ambient>0.88 0.85 0.75 1</ambient><diffuse>0.88 0.85 0.75 1</diffuse></material>
        </visual>
        <!-- South line -->
        <visual name="line_s">
          <pose>0 -60.0 0 0 0 0</pose>
          <geometry><box><size>90.0 0.20 0.001</size></box></geometry>
          <material><ambient>0.88 0.85 0.75 1</ambient><diffuse>0.88 0.85 0.75 1</diffuse></material>
        </visual>
        <!-- East line -->
        <visual name="line_e">
          <pose>45.0 0 0 0 0 0</pose>
          <geometry><box><size>0.20 120.0 0.001</size></box></geometry>
          <material><ambient>0.88 0.85 0.75 1</ambient><diffuse>0.88 0.85 0.75 1</diffuse></material>
        </visual>
        <!-- West line -->
        <visual name="line_w">
          <pose>-45.0 0 0 0 0 0</pose>
          <geometry><box><size>0.20 120.0 0.001</size></box></geometry>
          <material><ambient>0.88 0.85 0.75 1</ambient><diffuse>0.88 0.85 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Photogrammetric Ground Control Points (GCP Checkered Crosses on Tarmac) -->
    <model name="gcp_markers">
      <static>true</static>
      <pose>0 0 0.004 0 0 0</pose>
      <link name="link">
        <!-- GCP 1 at (-25, 30) -->
        <visual name="gcp_1_base"><pose>-25.0 30.0 0 0 0 0</pose><geometry><box><size>1.4 1.4 0.001</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="gcp_1_c1"><pose>-25.35 30.35 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="gcp_1_c2"><pose>-24.65 29.65 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>

        <!-- GCP 2 at (25, 30) -->
        <visual name="gcp_2_base"><pose>25.0 30.0 0 0 0 0</pose><geometry><box><size>1.4 1.4 0.001</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="gcp_2_c1"><pose>24.65 30.35 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="gcp_2_c2"><pose>25.35 29.65 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>

        <!-- GCP 3 at (-25, 90) -->
        <visual name="gcp_3_base"><pose>-25.0 90.0 0 0 0 0</pose><geometry><box><size>1.4 1.4 0.001</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="gcp_3_c1"><pose>-25.35 90.35 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="gcp_3_c2"><pose>-24.65 89.65 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>

        <!-- GCP 4 at (25, 90) -->
        <visual name="gcp_4_base"><pose>25.0 90.0 0 0 0 0</pose><geometry><box><size>1.4 1.4 0.001</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="gcp_4_c1"><pose>24.65 90.35 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="gcp_4_c2"><pose>25.35 89.65 0.001 0 0 0</pose><geometry><box><size>0.7 0.7 0.001</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
    </model>

