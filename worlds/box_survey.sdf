    <!-- Operational Helipad Launch Complex at (0, 0) -->
    <model name="helipad_complex">
      <static>true</static>
      <pose>0.0 0.0 0.003 0 0 0</pose>
      <link name="link">
        <!-- Octagonal landing pad border -->
        <visual name="pad_surface">
          <geometry><cylinder><radius>4.0</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.22 0.24 0.28 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material>
        </visual>
        <!-- White Ring Marking -->
        <visual name="white_ring">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><cylinder><radius>3.2</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
        <visual name="inner_pad">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><cylinder><radius>2.9</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.22 0.24 0.28 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material>
        </visual>
        <!-- Bold White "H" Marking -->
        <visual name="h_bar_left"><pose>-0.6 0 0.005 0 0 0</pose><geometry><box><size>0.28 1.6 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
