      </link>
    </model>

    <!-- ================================================================ -->
    <!-- REALISTIC NATURAL TERRAIN: CONTOURED HILLS, BERMS & BOULDERS     -->
    <!-- ================================================================ -->

    <!-- Natural Rolling Knoll (North-West Terraced Contoured Elevation +0.6m) -->
    <model name="natural_knoll_nw">
      <static>true</static>
      <pose>-25.0 85.0 0 0 0 0.35</pose>
      <link name="link">
        <!-- Tier 1: Gentle Base Slope (+0.22m) -->
        <collision name="col_t1"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>22.0 16.0 0.22</size></box></geometry></collision>
        <visual name="vis_t1"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>22.0 16.0 0.22</size></box></geometry><material><ambient>0.38 0.46 0.34 1</ambient><diffuse>0.42 0.50 0.38 1</diffuse></material></visual>
        <!-- Tier 2: Mid Elevation (+0.44m) -->
        <collision name="col_t2"><pose>0 0 0.33 0 0 0</pose><geometry><box><size>15.0 11.0 0.22</size></box></geometry></collision>
        <visual name="vis_t2"><pose>0 0 0.33 0 0 0</pose><geometry><box><size>15.0 11.0 0.22</size></box></geometry><material><ambient>0.40 0.48 0.36 1</ambient><diffuse>0.44 0.52 0.40 1</diffuse></material></visual>
        <!-- Tier 3: Summit Crest (+0.65m) -->
