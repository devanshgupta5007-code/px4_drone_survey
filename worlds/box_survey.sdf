        <visual name="vis_t3"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>9.0 6.5 0.22</size></box></geometry><material><ambient>0.42 0.50 0.38 1</ambient><diffuse>0.46 0.54 0.42 1</diffuse></material></visual>
      </link>
