      </link>
    </model>

    <!-- Field Weather Station & Anemometer Mast near Launch Pad -->
    <model name="weather_mast">
      <static>true</static>
      <pose>-6.0 -4.0 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.08</radius><length>2.8</length></cylinder></geometry><pose>0 0 1.4 0 0 0</pose></collision>
        <visual name="pole"><pose>0 0 1.4 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>2.8</length></cylinder></geometry><material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.75 0.78 0.82 1</diffuse></material></visual>
